#!/usr/bin/env python3

import os
import shlex
import subprocess
import sys
import random
import argparse
import shutil
import tempfile


parser = argparse.ArgumentParser(description='Stabilizer Compiler Driver')

# Which randomizations should be run
parser.add_argument('-R', action='append', choices=['code', 'heap', 'stack', 'link'], default=[])

# Driver control arguments
parser.add_argument('-v', action='store_true')
parser.add_argument('-lang', choices=['c', 'c++', 'fortran'])
parser.add_argument('-platform', choices=['auto', 'linux', 'osx'], default='auto')
parser.add_argument('-frontend', choices=['gcc', 'clang'], default='clang')

# Compiler pass-through arguments
parser.add_argument('-c', action='store_true')
parser.add_argument('-o')
# NOTE: default to the standard opt -O2 pipeline.
# For code randomization, we also preserve text relocations in the final binary
# so the Stabilizer runtime can fix up remaining pc-relative references (e.g.,
# constant pools) after moving code.
parser.add_argument('-O', type=int, choices=range(4), default=2)
parser.add_argument('-g', action='store_true')
parser.add_argument('-f', action='append', default=[])
parser.add_argument('-D', action='append', default=[])
parser.add_argument('-L', action='append', default=[])
parser.add_argument('-I', action='append', default=[])
parser.add_argument('-l', action='append', default=[])
parser.add_argument('input', nargs='*')

# Options (mostly GCC/Clang style, as used by autoconf/make based builds) that
# szc does not interpret are passed through.  Options taking a separate value
# are paired up first, so the value is not mistaken for an input file.
LINK_ONLY_PAIRS = {'-Xlinker'}
COMPILE_ONLY_PAIRS = {'-MF', '-MT', '-MQ', '-include', '-isystem', '-idirafter',
                      '-iquote', '-Xclang', '-x'}
LINK_ONLY_PREFIXES = ('-Wl,', '-fuse-ld=', '-rtlib=', '--rtlib=')
LINK_ONLY_FLAGS = {'-shared', '-rdynamic', '-static', '-pie', '-no-pie'}
BOTH_FLAGS = {'-pthread'}

argv = sys.argv[1:]
compile_extra = []
link_extra = []
rest = []
i = 0
while i < len(argv):
	a = argv[i]
	if (a in LINK_ONLY_PAIRS or a in COMPILE_ONLY_PAIRS) and i + 1 < len(argv):
		(link_extra if a in LINK_ONLY_PAIRS else compile_extra).extend(argv[i:i+2])
		i += 2
		continue
	rest.append(a)
	i += 1

args, unknown = parser.parse_known_args(rest)
for a in unknown:
	if not a.startswith('-') or a == '-':
		args.input.append(a)
	elif a in LINK_ONLY_FLAGS or a.startswith(LINK_ONLY_PREFIXES):
		link_extra.append(a)
	elif a in BOTH_FLAGS or a.startswith('-m'):
		compile_extra.append(a)
		link_extra.append(a)
	else:
		compile_extra.append(a)

SHARED = '-shared' in link_extra
ASM_SUFFIXES = ('.s', '.S', '.sx', '.asm')
SOURCE_SUFFIXES = ASM_SUFFIXES + ('.c', '.i', '.cc', '.cp', '.cpp', '.cxx', '.c++', '.C', '.ii',
                                  '.f', '.F', '.for', '.f77', '.f90', '.F90', '.f95', '.F95', '.f03', '.f08')

if args.frontend == 'gcc':
	print('GCC/DragonEgg frontend is no longer supported. Use -frontend=clang (C/C++) or -lang=fortran (Flang).')
	exit(1)

def _print_cmd(cmd):
	print(shlex.join(cmd))

def run(cmd):
	if args.v:
		_print_cmd(cmd)
	subprocess.check_call(cmd)

def try_run(cmd):
	if args.v:
		_print_cmd(cmd)
	return subprocess.call(cmd) == 0

def require_flang():
	if not FLANG:
		print('Fortran requested but flang was not found. Ensure `flang` (or `flang-new`) is in PATH.')
		exit(1)
	return FLANG


def getPlatform():
	if sys.platform == 'darwin':
		return 'osx'
	elif sys.platform.startswith('linux'):
		return 'linux'
	else:
		print('Unsupported platform')
		exit(2)

def arg(flag, values):
	if not isinstance(values, list):
		values = [values]

	out = []
	for v in values:
		if v == True:
			out.append('-' + flag)
		elif v == False or v is None:
			pass
		else:
			out.append('-' + flag + str(v))
	return out

if args.platform == 'auto':
	args.platform = getPlatform()

STABILIZER_HOME = os.path.dirname(os.path.abspath(__file__))

if args.platform == 'osx':
	LIBSUFFIX = 'dylib'
	args.frontend = 'clang'
else:
	LIBSUFFIX = 'so'

OPT = 'opt'
LLVM_LINK = 'llvm-link'
LLC = 'llc'
LLVM_AS = 'llvm-as'

FLANG = shutil.which('flang') or shutil.which('flang-new')

def szc_only(a):
	return a.startswith(('-R', '-lang', '-platform', '-frontend')) or a == '-v'

# Preprocess-only, assembly-only, dependency-only and query invocations (for
# example `-E`, `--version`, `-print-multiarch`), as well as assembling native
# assembly sources, do not produce anything to instrument: run the frontend
# unchanged.
PASSTHROUGH_FLAGS = {'-E', '-S', '-M', '-MM', '-fsyntax-only'}
if (not args.input or PASSTHROUGH_FLAGS & set(compile_extra) or
	(args.c and all(x.endswith(ASM_SUFFIXES) for x in args.input))):
	cmd = [args.frontend] + [a for a in sys.argv[1:] if not szc_only(a)]
	if args.v:
		print(shlex.join(cmd))
	exit(subprocess.call(cmd))

if not args.o:
	# Match common compiler defaults, and avoid confusing TypeErrors later.
	if args.c and len(args.input) == 1 and not args.input[0].endswith('.o'):
		base = os.path.splitext(os.path.basename(args.input[0]))[0]
		args.o = base + '.o'
	else:
		args.o = 'a.out'

passes = []
opts = []

def _have_libstdcxx():
	# The C++ runtime is needed for C++ inputs; libstabilizer.so already
	# depends on it.  Some toolchains (e.g. clang selecting a GCC installation
	# without libstdc++-dev) cannot resolve -lstdc++ at all, which must not
	# break linking plain C programs.
	try:
		out = subprocess.run([args.frontend, '-print-file-name=libstdc++.so'],
			capture_output=True, text=True).stdout.strip()
	except OSError:
		return False
	return os.path.isabs(out)

if not args.c and (args.lang == 'c++' or _have_libstdcxx()):
	args.l.append('stdc++')
# args.v = True

if 'code' in args.R:
	passes.append('lower-intrinsics')
	passes.append('lower-switch')
	passes.append('lower-invoke')
	opts.append('stabilize-code')

if 'stack' in args.R:
	opts.append('stabilize-stack')

if 'heap' in args.R:
	opts.append('stabilize-heap')

# Shared objects are not instrumented: the runtime does not support
# registering instrumented modules after startup.  They are optimised and
# linked as ordinary (whole-module) native code.
if SHARED:
	args.R = [r for r in args.R if r == 'link']
	passes = []
	opts = []

if 'code' in args.R or 'heap' in args.R or 'stack' in args.R:
	args.L.append(STABILIZER_HOME)
	args.l.append('stabilizer')
	passes.append('stabilize')
	if args.platform == 'linux':
		link_extra.append('-Wl,-rpath,' + STABILIZER_HOME)

TMPDIR = None
def tmpdir():
	global TMPDIR
	if TMPDIR is None:
		TMPDIR = tempfile.mkdtemp(prefix='szc.', dir=os.path.dirname(os.path.abspath(args.o)))
	return TMPDIR

BITCODE_MAGIC = b'BC\xc0\xde'
ARCHIVE_MAGIC = b'!<arch>\n'

def file_magic(path):
	try:
		with open(path, 'rb') as f:
			return f.read(8)
	except OSError:
		return b''

def archive_members(path):
	"""Yield (name, data) for the members of a System V/GNU `ar` archive."""
	with open(path, 'rb') as f:
		data = f.read()
	pos = len(ARCHIVE_MAGIC)
	longnames = b''
	while pos + 60 <= len(data):
		header = data[pos:pos+60]
		name = header[0:16].decode().rstrip()
		size = int(header[48:58].decode().strip())
		body = data[pos+60:pos+60+size]
		pos += 60 + size + (size & 1)
		if name == '//':
			longnames = body
		elif name in ('/', '/SYM64/', '__.SYMDEF', '__.SYMDEF SORTED'):
			continue
		else:
			if name.startswith('/') and name[1:].isdigit():
				off = int(name[1:])
				name = longnames[off:longnames.index(b'\n', off)].decode()
			yield name.rstrip('/'), body

def split_inputs(inputs):
	"""Separate LLVM bitcode (to be linked and instrumented) from native
	objects/libraries (passed to the final native link).  Archives are
	expanded: every member is linked, as with --whole-archive."""
	bitcode = []
	native = []
	for path in inputs:
		magic = file_magic(path)
		if magic.startswith(BITCODE_MAGIC):
			bitcode.append(path)
		elif magic.startswith(ARCHIVE_MAGIC):
			for n, (name, body) in enumerate(archive_members(path)):
				out = os.path.join(tmpdir(), '%d.%s' % (n, os.path.basename(name)))
				with open(out, 'wb') as f:
					f.write(body)
				(bitcode if body.startswith(BITCODE_MAGIC) else native).append(out)
		else:
			native.append(path)
	return bitcode, native

def compile(input):
	if not input.endswith(SOURCE_SUFFIXES):
		# Objects, archives and libraries.
		return input

	if not args.c:
		# Compiling and linking in one step: keep per-source bitcode separate
		# from the final output.
		output = os.path.join(tmpdir(), os.path.splitext(os.path.basename(input))[0] +
			('.o' if input.endswith(ASM_SUFFIXES) else '.bc'))
	else:
		output = args.o

	if input.endswith(ASM_SUFFIXES):
		run([args.frontend, '-c', '-o', output] + arg('I', args.I) + arg('D', args.D) + compile_extra + [input])
		return output

	if args.lang == 'fortran':
		flang = require_flang()
		common = arg('g', args.g) + arg('I', args.I) + arg('f', args.f) + arg('D', args.D)

		# Emit LLVM bitcode via flang. Try O0 first; fall back if needed.
		for opt in ['0', '1']:
			cmd = [flang, '-O' + opt, '-c', '-emit-llvm', '-o', output]
			cmd += common
			cmd.append(input)
			if try_run(cmd):
				return output

		# Last resort: emit LLVM IR assembly and assemble it.
		ll = output + '.ll'
		cmd = [flang, '-O1', '-S', '-emit-llvm', '-o', ll]
		cmd += common
		cmd.append(input)
		run(cmd)
		run([LLVM_AS, '-o', output, ll])

	else:
		# Optimise each translation unit at the requested level; transform()
		# subsequently optimises the linked module before instrumentation.
		# Always using -O0 leaves noinline on ordinary inline helpers even if
		# optnone is disabled, preventing subsequent opt -O2 from inlining them.
		# Do not disable all Clang LLVM passes: that also silently suppresses
		# requested instrumentation such as AddressSanitizer.
		if args.O > 0:
			frontend_flags = ['-O' + str(args.O)]
		else:
			# Keep -O0 semantics, but let required lowering/instrumentation run.
			frontend_flags = ['-O0', '-Xclang', '-disable-O0-optnone']
		cmd = [args.frontend] + frontend_flags + ['-c', '-emit-llvm', '-o', output]
		cmd += arg('g', args.g)
		cmd += arg('I', args.I)
		cmd += arg('f', args.f)
		cmd += arg('D', args.D)
		cmd += compile_extra
		cmd.append(input)
		run(cmd)

	return output

def link(inputs):
	cmd = [LLVM_LINK, '-o', args.o + '.bc']

	if 'link' in args.R:
		random.shuffle(inputs)

	cmd += inputs

	run(cmd)
	return args.o + '.bc'

def transform(input):
	cmd = [OPT, '-o', args.o + '.opt.bc', input]
	plugin = os.path.join(STABILIZER_HOME, 'LLVMStabilizer.' + LIBSUFFIX)
	cmd.append('--load-pass-plugin=' + plugin)

	pipeline = []
	if args.O > 0:
		pipeline.append('default<O' + str(args.O) + '>')

	pipeline.extend(passes)
	if not pipeline:
		return input
	cmd.append('-passes=' + ','.join(pipeline))

	for v in opts:
		cmd.append('-' + v + '=true')

	run(cmd)
	return args.o + '.opt.bc'

def codegen(input, native):
	# Honour the requested optimisation level throughout the pipeline while
	# retaining the code-relocation and legacy stack-walk requirements.
	cmd = [LLC, '-O' + str(args.O), '-relocation-model=pic', '--frame-pointer=all']
	# Emit a native object file and link it directly. Flang's driver currently
	# does not accept assembly (`.s`) inputs (it can error with "unknown
	# integrated tool '-cc1as'"), so avoid producing/linking `.s` here.
	llc_obj = args.o + '.llc.o'
	cmd += ['-filetype=obj', '-o', llc_obj, input]

	run(cmd)

	if args.lang == 'fortran':
		flang = require_flang()
		cmd = [flang]
	else:
		cmd = [args.frontend]

	cmd.append(llc_obj)
	cmd += native

	# Keep relocation records so the runtime can patch pc-relative references
	# after moving code.
	if args.platform == 'linux' and 'code' in args.R:
		cmd.append('-Wl,--emit-relocs')

	cmd += ['-o', args.o]
	cmd += arg('f', args.f)
	cmd += arg('L', args.L)
	cmd += arg('l', args.l)
	cmd += link_extra

	run(cmd)

	# Avoid leaving extra native objects behind. Keep intermediates only with -v.
	if not args.v:
		try:
			os.unlink(llc_obj)
		except OSError:
			pass

	return args.o

# Build up program arguments
object_files = list(map(compile, args.input))

try:
	if not args.c:
		bitcode, native = split_inputs(object_files)
		if bitcode:
			linked = link(bitcode)
			transformed = transform(linked)
			codegen(transformed, native)
		else:
			# Nothing to instrument (e.g. only native objects).
			run([args.frontend, '-o', args.o] + native + arg('f', args.f) +
				arg('L', args.L) + arg('l', args.l) + link_extra)
finally:
	if TMPDIR is not None and not args.v:
		shutil.rmtree(TMPDIR, ignore_errors=True)
